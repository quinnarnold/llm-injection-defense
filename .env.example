# vLLM endpoint (required)
VLLM_URL=http://localhost:8000

# SSH session GPU config
CUDA_VISIBLE_DEVICES=0

# vLLM model path (after merge+quantize)
MODEL_PATH=./models/qwen3-32b-bryant

# Classifier model path
CLASSIFIER_PATH=./models/classifier

# ChromaDB path
CHROMA_PATH=./data/chroma

# BM25 index path
BM25_PATH=./data/bm25/bm25.pkl

# Rate limiting
MAX_TURNS_PER_SESSION=50
MAX_REQUESTS_PER_MINUTE_PER_IP=20
SESSION_TTL_SECONDS=3600

# CORS (set to your frontend domain in production)
ALLOWED_ORIGINS=*

# vLLM config
VLLM_MAX_MODEL_LEN=4096

# RAG device placement
RAG_INDEX_DEVICE=cuda
RAG_QUERY_DEVICE=cpu
RAG_RERANK_DEVICE=cpu

# RAG retrieval tuning
RAG_DENSE_TOP_K=5
RAG_BM25_TOP_K=5
RAG_RERANK_TOP_K=3

# Groq API key (used by evaluation scripts only)
GROQ_API_KEY=
