# SSH session GPU config
CUDA_VISIBLE_DEVICES=0

# vLLM model path (after merge+quantize)
MODEL_PATH=./models/qwen3-32b-bryant

# Classifier model path
CLASSIFIER_PATH=./models/classifier

# ChromaDB path
CHROMA_PATH=./data/chroma

# BM25 index path
BM25_PATH=./data/bm25/bm25.pkl

# Rate limiting
MAX_TURNS_PER_SESSION=50
MAX_REQUESTS_PER_MINUTE_PER_IP=20

# vLLM config
VLLM_MAX_MODEL_LEN=4096

# Bootstrap Q&A generation (one-time use, not needed at runtime)
BOOTSTRAP_API_KEY=
